# ──────────────────────────────────────────────────────────
# Diego Desktop Assistant — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your secrets.
#   cp .env.example .env
# NEVER commit the .env file to version control.

# ── LLM Providers (at least one required for fallback) ──
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Telegram (user client, not bot) ──────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=Diego_telegram

# ── Telegram Bot (alternative for bot-based operations) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google / Firebase ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIREBASE_SERVICE_ACCOUNT_PATH=auth/serviceAccountKey.json

# ── Weather ──────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Speech / TTS ─────────────────────────────────────────
WHISPER_MODEL=base
COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
WAKE_WORD=Diego
LANG_CODE=en-IN
# ── STT backend selection ────────────────────────────────
# Primary command-STT backend. Default qwen3 = Qwen3-ASR 1.7B INT8 via
# sherpa-onnx (maximum English/Hindi/Hinglish accuracy). Qwen3-ASR 0.6B is
# still available for low-RAM machines: STT_MODEL_SIZE=0.6b.
# faster-whisper is ALWAYS kept alive as the verification / confidence source
# (Qwen3 exposes no log-probs), and STT_PRIMARY=faster_whisper restores the
# previous baseline. openai/gemini are reserved provider names: they report
# UNAVAILABLE and safely fall back — never faked.
STT_PRIMARY=qwen3
STT_FALLBACK=faster_whisper
# Qwen3-ASR model variant: 1.7b (default) or 0.6b
STT_MODEL_SIZE=1.7b
# ── Sarvam Saaras v4 (EXPERIMENTAL — benchmark only) ─────
# Isolated experimental provider used ONLY by
# scripts/phase24g_sarvam_benchmark.py to compare cloud Saaras v4 against the
# local models above. Setting STT_PRIMARY=sarvam does NOT switch Diego to the
# cloud: it is reported as EXPERIMENTAL and safely falls back to STT_FALLBACK.
# Never required at startup; empty key = provider UNAVAILABLE (never faked).
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
# SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
# SARVAM_TIMEOUT_S=30
# WAKE_DEVICE_INDEX=0

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────
DUCKDB_PATH=data/Diego.duckdb

# ── NLP / Embeddings ────────────────────────────────────
MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.75
