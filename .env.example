# ──────────────────────────────────────────────────────────
# Diego Desktop Assistant — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your secrets.
#   cp .env.example .env
# NEVER commit the .env file to version control.

# ── LLM Providers (at least one required for fallback) ──
GEMINI_API_KEY=AQ.Ab8RN6Iz2zvO-F0GuzF2WmKLfWJ0HbS_JNO5SfR_j5ssSMqtuQ
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Telegram (user client, not bot) ──────────────────────
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=Diego_telegram

# ── Telegram Bot (alternative for bot-based operations) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Google / Firebase ────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FIREBASE_SERVICE_ACCOUNT_PATH=auth/serviceAccountKey.json

# ── Weather ──────────────────────────────────────────────
OPENWEATHER_API_KEY=

# ── Speech / TTS ─────────────────────────────────────────
WHISPER_MODEL=base
COQUI_MODEL=tts_models/en/ljspeech/tacotron2-DDC
WAKE_WORD=Diego
LANG_CODE=en-IN
# WAKE_DEVICE_INDEX=0

# ── Logging ──────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────
DUCKDB_PATH=data/Diego.duckdb

# ── NLP / Embeddings ────────────────────────────────────
MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.75